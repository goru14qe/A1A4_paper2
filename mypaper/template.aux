\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Per-layer velocity profiles at Pos\,3 ($Re_P=100$) for the (a)\nobreakspace  {}$30^\circ $, (b)\nobreakspace  {}$40^\circ $, and (c)\nobreakspace  {}irregular packings. The periodic packings collapse onto a common profile, whereas the irregular packing exhibits significant layer-to-layer variability.\relax }}{26}{figure.caption.14}\protected@file@percent }
\newlabel{fig:line_profiles_topology}{{11}{26}{Per-layer velocity profiles at Pos\,3 ($Re_P=100$) for the (a)~$30^\circ $, (b)~$40^\circ $, and (c)~irregular packings. The periodic packings collapse onto a common profile, whereas the irregular packing exhibits significant layer-to-layer variability.\relax }{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Locking order parameter for the three topologies at $Re_P = 100$ (Pos\,3). Left: the layer-to-layer matrix $L$ (Eq.\nobreakspace  {}\ref  {eq:Ln}) evaluated on the pairwise fluid mask; right: per-layer locking $L(n)$ against the across-layer mean field. The (a)\nobreakspace  {}$30^\circ $ and (b)\nobreakspace  {}$40^\circ $ packings lock at $L \approx 1.00$ and $0.99$ respectively, whereas (c)\nobreakspace  {}the irregular packing scatters between $L = 0.10$ and $0.68$ with no systematic repeat, confirming that the geometric period is required for locking.\relax }}{27}{figure.caption.15}\protected@file@percent }
\newlabel{fig:Ln}{{12}{27}{Locking order parameter for the three topologies at $Re_P = 100$ (Pos\,3). Left: the layer-to-layer matrix $L$ (Eq.~\ref {eq:Ln}) evaluated on the pairwise fluid mask; right: per-layer locking $L(n)$ against the across-layer mean field. The (a)~$30^\circ $ and (b)~$40^\circ $ packings lock at $L \approx 1.00$ and $0.99$ respectively, whereas (c)~the irregular packing scatters between $L = 0.10$ and $0.68$ with no systematic repeat, confirming that the geometric period is required for locking.\relax }{figure.caption.15}{}}
