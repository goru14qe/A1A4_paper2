\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Locking metric at Re$_p=300$ for the (a) $30^\circ $ and (b) $40^\circ $ periodic packings. Both packings remain strongly locked ($\overline  {L}=0.973$ at $30^\circ $, $\overline  {L}=0.981$ at $40^\circ $), but at a slightly lower level than at Re$_p=100$ ($\overline  {L}=0.998$ and $0.993$).}}{39}{figure.caption.38}\protected@file@percent }
\newlabel{fig:Ln_re300}{{13}{39}{Locking metric at Re$_p=300$ for the (a) $30^\circ $ and (b) $40^\circ $ periodic packings. Both packings remain strongly locked ($\overline {L}=0.973$ at $30^\circ $, $\overline {L}=0.981$ at $40^\circ $), but at a slightly lower level than at Re$_p=100$ ($\overline {L}=0.998$ and $0.993$)}{figure.caption.38}{}}
