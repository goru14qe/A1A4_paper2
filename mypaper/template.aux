\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Results in the in-plane system for the time-averaged velocity magnitude obtained by LBM together with in-plane streamlines for all layers L03 to L17 of the packing with $\theta =30^\circ $ at Re$_p=100$. The periodic geometry produces a single repeating flow pattern across all developed layers, with noticeable differences observed only for L03, still impacted by the inflow condition.}}{34}{figure.caption.32}\protected@file@percent }
\newlabel{fig:velocity_fields_30}{{10}{34}{Results in the in-plane system for the time-averaged velocity magnitude obtained by LBM together with in-plane streamlines for all layers L03 to L17 of the packing with $\theta =30^\circ $ at Re$_p=100$. The periodic geometry produces a single repeating flow pattern across all developed layers, with noticeable differences observed only for L03, still impacted by the inflow condition}{figure.caption.32}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1}Flow Locking in Periodic and Irregular Packings}{34}{section*.34}\protected@file@percent }
\newlabel{sec:locking:topologies}{{V\,D\,1}{34}{}{section*.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Profiles of time-averaged velocity magnitude obtained by LBM at different heights within a module in each layer L03 to L17 at Pos3 for Re$_p=100$ in the topology (a)~$\theta =30^\circ $, (b)~$\theta =40^\circ $, and (c)~irregular packing. The periodic packings collapse mostly onto a common profile (though the first layer, L03, is still strongly impacted by the inflow condition), whereas the irregular packing exhibits very strong layer-to-layer variability throughout the whole bed.}}{35}{figure.caption.33}\protected@file@percent }
\newlabel{fig:line_profiles_topology}{{11}{35}{Profiles of time-averaged velocity magnitude obtained by LBM at different heights within a module in each layer L03 to L17 at Pos3 for Re$_p=100$ in the topology (a)~$\theta =30^\circ $, (b)~$\theta =40^\circ $, and (c)~irregular packing. The periodic packings collapse mostly onto a common profile (though the first layer, L03, is still strongly impacted by the inflow condition), whereas the irregular packing exhibits very strong layer-to-layer variability throughout the whole bed}{figure.caption.33}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2}Flow Organisation}{36}{section*.36}\protected@file@percent }
\newlabel{sec:organisation}{{V\,D\,2}{36}{}{section*.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Locking order parameter at Pos3 for the $30^\circ $ and $40^\circ $ packings at Re$_p = 100$ and for the irregular packing at Re$_p = 300$. Left: layer-to-layer matrix $L$ (Eq.~(\ref {eq:Ln})); Right: per-layer locking $L(n)$ against the mean field involving all layers. The values for the (a)~$30^\circ $ and (b)~$40^\circ $ packings remain constant at $L \approx 1.00$ and $0.99$ respectively, whereas (c)~values for the irregular packing are much lower ($\overline  {L}=0.46$, individual layer-pair values between $0.10$ and $0.68$, $L(n)$ between $0.67$ and $0.83$), confirming that a constant rotation angle is required for locking.}}{37}{figure.caption.35}\protected@file@percent }
\newlabel{fig:Ln}{{12}{37}{Locking order parameter at Pos3 for the $30^\circ $ and $40^\circ $ packings at Re$_p = 100$ and for the irregular packing at Re$_p = 300$. Left: layer-to-layer matrix $L$ (Eq.~(\ref {eq:Ln})); Right: per-layer locking $L(n)$ against the mean field involving all layers. The values for the (a)~$30^\circ $ and (b)~$40^\circ $ packings remain constant at $L \approx 1.00$ and $0.99$ respectively, whereas (c)~values for the irregular packing are much lower ($\overline {L}=0.46$, individual layer-pair values between $0.10$ and $0.68$, $L(n)$ between $0.67$ and $0.83$), confirming that a constant rotation angle is required for locking}{figure.caption.35}{}}
