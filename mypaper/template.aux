\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces De-rotated results for the time-averaged velocity magnitude obtained by LBM together with in-plane streamlines for all layers L3 to L17 of the packing with $\theta =30^\circ $ at Re$_p=100$. The periodic geometry produces a single repeating flow pattern across all developed layers, with noticeable differences observed only for L03, still impacted by the inflow condition.}}{30}{figure.caption.13}\protected@file@percent }
\newlabel{fig:velocity_fields_30}{{10}{30}{De-rotated results for the time-averaged velocity magnitude obtained by LBM together with in-plane streamlines for all layers L3 to L17 of the packing with $\theta =30^\circ $ at Re$_p=100$. The periodic geometry produces a single repeating flow pattern across all developed layers, with noticeable differences observed only for L03, still impacted by the inflow condition}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Profiles of time-averaged velocity magnitude obtained by LBM at different heights within a module after de-rotation in each layer L03 to L17 at Pos3 for Re$_p=100$ in the topology (a)~$\theta =30^\circ $, (b)~$\theta =40^\circ $, and (c)~irregular packing. The periodic packings collapse mostly onto a common profile (though the first layer, L03, is still strongly impacted by the inflow condition), whereas the irregular packing exhibits very strong layer-to-layer variability throughout the whole bed.}}{31}{figure.caption.14}\protected@file@percent }
\newlabel{fig:line_profiles_topology}{{11}{31}{Profiles of time-averaged velocity magnitude obtained by LBM at different heights within a module after de-rotation in each layer L03 to L17 at Pos3 for Re$_p=100$ in the topology (a)~$\theta =30^\circ $, (b)~$\theta =40^\circ $, and (c)~irregular packing. The periodic packings collapse mostly onto a common profile (though the first layer, L03, is still strongly impacted by the inflow condition), whereas the irregular packing exhibits very strong layer-to-layer variability throughout the whole bed}{figure.caption.14}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {5.4.1}Flow Locking in Periodic and Irregular Packings}{32}{subsubsection.5.4.1}\protected@file@percent }
\newlabel{sec:locking:topologies}{{5.4.1}{32}{Flow Locking in Periodic and Irregular Packings}{subsubsection.5.4.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Locking order parameter at Pos3 for the $30^\circ $ and $40^\circ $ packings at Re$_p = 100$ and for the irregular packing at Re$_p = 300$. Left: layer-to-layer matrix $L$ (Eq.~\ref {eq:Ln}); Right: per-layer locking $L(n)$ against the mean field involving all layers. The (a)~$30^\circ $ and (b)~$40^\circ $ packings remain constant at $L \approx 1.00$ and $0.99$ respectively, whereas (c)~the irregular packing is much lower ($\overline  {L}=0.46$, individual layer-pair values between $0.10$ and $0.68$, $L(n)$ between $0.67$ and $0.83$), confirming that the geometric period is required for locking.}}{33}{figure.caption.15}\protected@file@percent }
\newlabel{fig:Ln}{{12}{33}{Locking order parameter at Pos3 for the $30^\circ $ and $40^\circ $ packings at Re$_p = 100$ and for the irregular packing at Re$_p = 300$. Left: layer-to-layer matrix $L$ (Eq.~\ref {eq:Ln}); Right: per-layer locking $L(n)$ against the mean field involving all layers. The (a)~$30^\circ $ and (b)~$40^\circ $ packings remain constant at $L \approx 1.00$ and $0.99$ respectively, whereas (c)~the irregular packing is much lower ($\overline {L}=0.46$, individual layer-pair values between $0.10$ and $0.68$, $L(n)$ between $0.67$ and $0.83$), confirming that the geometric period is required for locking}{figure.caption.15}{}}
