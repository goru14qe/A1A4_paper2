\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Symmetry Verification}{17}{subsection.5.2}\protected@file@percent }
\newlabel{sec:numerics:symmetry}{{5.2}{17}{Symmetry Verification}{subsection.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Symmetry verification for the $30^\circ $ packing at Re$_p = 100$, for the two point-symmetric measurement pairs. (a,b)~Pos3 and Pos5; (c,d)~Pos1 and Pos7. (a,c)~Time-averaged contours of velocity magnitude with in-plane streamlines, showing that each plane maps onto the mirror image of its partner. (b,d)~Line profiles of time-averaged velocity magnitude across the gaps at four streamwise heights, comparing each plane (solid lines) with its point-symmetric partner (symbols) plotted after inverting the $x$ coordinate. Both pairs coincide to within line width, verifying the perfect symmetry of the simulated mean flow.}}{19}{figure.caption.7}\protected@file@percent }
\newlabel{fig:symmetry}{{4}{19}{Symmetry verification for the $30^\circ $ packing at Re$_p = 100$, for the two point-symmetric measurement pairs. (a,b)~Pos3 and Pos5; (c,d)~Pos1 and Pos7. (a,c)~Time-averaged contours of velocity magnitude with in-plane streamlines, showing that each plane maps onto the mirror image of its partner. (b,d)~Line profiles of time-averaged velocity magnitude across the gaps at four streamwise heights, comparing each plane (solid lines) with its point-symmetric partner (symbols) plotted after inverting the $x$ coordinate. Both pairs coincide to within line width, verifying the perfect symmetry of the simulated mean flow}{figure.caption.7}{}}
