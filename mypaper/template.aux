\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Grid sensitivity study on a representative subdomain of the regular packing with $\theta =40^\circ $. (a)~Geometry showing the extraction plane position for grid convergence assessment. (b-d)~Time-averaged fields of velocity magnitude $|V|$ on the extraction surface for the three grid levels of Table~\ref {tab:grid}, keeping the same colour scale. The jet structure is preserved across all resolutions; the medium and fine fields are nearly identical, see Table~\ref {tab:grid} for quantitative values.}}{22}{figure.caption.18}\protected@file@percent }
\newlabel{fig:grid}{{3}{22}{Grid sensitivity study on a representative subdomain of the regular packing with $\theta =40^\circ $. (a)~Geometry showing the extraction plane position for grid convergence assessment. (b-d)~Time-averaged fields of velocity magnitude $|V|$ on the extraction surface for the three grid levels of Table~\ref {tab:grid}, keeping the same colour scale. The jet structure is preserved across all resolutions; the medium and fine fields are nearly identical, see Table~\ref {tab:grid} for quantitative values}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Symmetry verification for the $30^\circ $ packing at Re$_p = 100$, for the two point-symmetric measurement pairs. (a,b)~Pos3 and Pos5; (c,d)~Pos1 and Pos7. (a,c)~Time-averaged contours of velocity magnitude with in-plane streamlines, showing that each plane approximately maps onto the mirror image of its partner. (b,d)~Line profiles of time-averaged velocity magnitude across the gaps at four streamwise heights, comparing each plane (solid lines) with its point-symmetric partner (symbols) plotted after inverting the $x$ coordinate. The central jets of both pairs coincide closely, whereas the magnitudes of some side peaks differ (e.g., Pos3 vs Pos5 at $z=180$\,mm), so the symmetry of the simulated mean flow is approximate.}}{23}{figure.caption.20}\protected@file@percent }
\newlabel{fig:symmetry}{{4}{23}{Symmetry verification for the $30^\circ $ packing at Re$_p = 100$, for the two point-symmetric measurement pairs. (a,b)~Pos3 and Pos5; (c,d)~Pos1 and Pos7. (a,c)~Time-averaged contours of velocity magnitude with in-plane streamlines, showing that each plane approximately maps onto the mirror image of its partner. (b,d)~Line profiles of time-averaged velocity magnitude across the gaps at four streamwise heights, comparing each plane (solid lines) with its point-symmetric partner (symbols) plotted after inverting the $x$ coordinate. The central jets of both pairs coincide closely, whereas the magnitudes of some side peaks differ (e.g., Pos3 vs Pos5 at $z=180$\,mm), so the symmetry of the simulated mean flow is approximate}{figure.caption.20}{}}
