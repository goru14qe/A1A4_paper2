\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Symmetry verification for the $30^\circ $ packing at $Re_P = 100$, for the two point-symmetric measurement pairs. (a,b)\nobreakspace  {}Pos\,3 and Pos\,5; (c,d)\nobreakspace  {}Pos\,1 and Pos\,7. (a,c)\nobreakspace  {}Time-averaged velocity-magnitude contours with in-plane streamlines, showing that each plane maps onto the mirror image of its partner. (b,d)\nobreakspace  {}Velocity-magnitude line profiles across the plane at four streamwise heights, comparing each plane (solid) with its point-symmetric partner (dashed). Both pairs coincide to within line width, verifying the $180^\circ $ symmetry of the simulated mean flow.\relax }}{17}{figure.caption.7}\protected@file@percent }
\newlabel{fig:symmetry}{{4}{17}{Symmetry verification for the $30^\circ $ packing at $Re_P = 100$, for the two point-symmetric measurement pairs. (a,b)~Pos\,3 and Pos\,5; (c,d)~Pos\,1 and Pos\,7. (a,c)~Time-averaged velocity-magnitude contours with in-plane streamlines, showing that each plane maps onto the mirror image of its partner. (b,d)~Velocity-magnitude line profiles across the plane at four streamwise heights, comparing each plane (solid) with its point-symmetric partner (dashed). Both pairs coincide to within line width, verifying the $180^\circ $ symmetry of the simulated mean flow.\relax }{figure.caption.7}{}}
